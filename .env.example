# Desenvolvimento fora do Docker (npm run dev) usando o Postgres do docker-compose.dev.yml.
# Em produção (Easypanel) esta variável é definida no painel, não em arquivo.
DATABASE_URL="postgresql://lampada:lampada@localhost:5432/lampada?schema=public"

# Login: gere com  npm run auth:setup -- <usuario> <senha>
AUTH_USERNAME=""
AUTH_PASSWORD_HASH=""
AUTH_SECRET=""
